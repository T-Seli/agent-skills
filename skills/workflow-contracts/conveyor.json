{
  "note": "Machine-readable lanes and receipts for conveyor.md. Gates read receipts by these patterns; limits live in contracts.md § Defaults `Lane limits`, never here.",
  "version": 1,
  "labels": {
    "lane": "lane:<name>",
    "domain": "domain:<name>",
    "size": [
      "size:S",
      "size:M",
      "size:L"
    ],
    "priority": [
      "prio:now",
      "prio:next",
      "prio:later"
    ],
    "modifiers": [
      "hold",
      "needs-human"
    ],
    "folds": {
      "ready-for-agent": "lane:backlog"
    }
  },
  "lanes": [
    {
      "name": "inbox",
      "requires": [
        "capture"
      ],
      "called_at": "issues-cli capture"
    },
    {
      "name": "backlog",
      "requires": [
        "domain",
        "size"
      ],
      "called_at": "sort pass"
    },
    {
      "name": "next",
      "requires": [
        "owner",
        "domain",
        "done_when"
      ],
      "called_at": "issues-cli publish or sweep pull",
      "room": "free Build slots"
    },
    {
      "name": "in-progress",
      "requires": [
        "claim",
        "brief"
      ],
      "limit": "Build",
      "called_at": "implement Start record"
    },
    {
      "name": "in-review",
      "requires": [
        "implement_done",
        "pr"
      ],
      "limit": "Review",
      "called_at": "implement done record"
    },
    {
      "name": "ready-to-release",
      "requires": [
        "reviewed_yes",
        "reviewer"
      ],
      "called_at": "test-review YES"
    },
    {
      "name": "monitoring",
      "requires": [
        "approved",
        "deploy",
        "rollback",
        "schedule",
        "schedule"
      ],
      "called_at": "safeguard-cli run-approved"
    },
    {
      "name": "closed",
      "requires": [
        "monitor_first",
        "monitor_24h",
        "monitor_deleted",
        "monitor_deleted",
        "learned"
      ],
      "called_at": "monitor end"
    }
  ],
  "receipts": {
    "capture": {
      "source": "issue_body",
      "pattern": "^Captured: \\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}Z · source \\S+$"
    },
    "domain": {
      "source": "labels",
      "pattern": "^domain:[a-z0-9-]+$",
      "count": 1
    },
    "size": {
      "source": "labels",
      "pattern": "^size:[SML]$",
      "count": 1
    },
    "owner": {
      "source": "issue_comment",
      "pattern": "^Owner: (?P<owner>\\S+) · session (?P<session>\\S+) · \\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}Z$",
      "written_by": "publish"
    },
    "done_when": {
      "source": "issue_body",
      "pattern": "^Done when: .+$"
    },
    "claim": {
      "source": "issue_comment",
      "pattern": "^Claimed: branch `[^`]+` · session (?P<session>\\S+)$"
    },
    "brief": {
      "source": "timeline",
      "command": "brief"
    },
    "implement_done": {
      "source": "log",
      "pattern": "^## \\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}Z — implement: done"
    },
    "pr": {
      "source": "linked_pr",
      "count": 1
    },
    "reviewed_yes": {
      "source": "log",
      "pattern": "^Reviewed: (?P<head>[0-9a-f]{7,40}) YES$",
      "binds": "pr_head"
    },
    "approved": {
      "source": "log",
      "pattern": "^Approved: (?P<kind>release|rollback|skills-install) (?P<id>\\S+) · digest (?P<digest>[0-9a-f]{64}) · (?P<time>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}Z) · question (?P<question>https?://\\S+) · session (?P<session>\\S+)$",
      "written_by": "run-approved"
    },
    "deploy": {
      "source": "log",
      "pattern": "deploy: (?P<sha>[0-9a-f]{7,40}) to .+"
    },
    "rollback": {
      "source": "log",
      "pattern": "^Rollback: \\S+: \\S+"
    },
    "schedule": {
      "source": "log",
      "pattern": "^Scheduler: \\S+ \\S+$"
    },
    "learned": {
      "source": "closing_comment",
      "pattern": "^Learned: (none|lesson: .+|answered: .+ => .+|page-fix: \\S+: .+)$"
    },
    "reviewer": {
      "source": "log",
      "pattern": "^Reviewer: session (?P<session>\\S+) · head (?P<head>[0-9a-f]{7,40}) · (?P<route>outside|fallback)$",
      "binds": "pr_head",
      "not_equal": "claim.session"
    },
    "review_requested": {
      "source": "issue_comment",
      "pattern": "^Review requested: head (?P<head>[0-9a-f]{7,40}) · (?P<time>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}Z) · session (?P<session>\\S+)$"
    },
    "monitor_first": {
      "source": "log",
      "pattern": "^Monitor verdict: first-traffic (?P<verdict>All working|Working, with issues) · \\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}Z$"
    },
    "monitor_24h": {
      "source": "log",
      "pattern": "^Monitor verdict: 24h (?P<verdict>All working|Working, with issues) · \\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}Z$"
    },
    "monitor_deleted": {
      "source": "log",
      "pattern": "^Scheduler deleted: (?P<runtime>\\S+) (?P<id>\\S+)$",
      "binds": "schedule.id"
    },
    "decision": {
      "source": "issue_comment",
      "pattern": "^Decision: (?P<text>.+) · (?P<time>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}Z) · question (?P<question>https?://\\S+) · session (?P<session>\\S+)$",
      "written_by": "decide"
    },
    "asked_more": {
      "source": "issue_comment",
      "pattern": "^Asked for more: (?P<time>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}Z) · question (?P<question>https?://\\S+)$",
      "written_by": "ask"
    }
  },
  "timeline": {
    "pattern": "^Conveyor: (?P<time>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}Z) · (?P<command>capture|prio|publish|claim|lane|decide|brief|ask|run-approved|sweep|close) · (?P<from>[a-z-]+|-) → (?P<to>[a-z-]+|-) · head (?P<head>[0-9a-f]{7,40}|-) · tests (?P<tests>\\S+) · skills (?P<skills>[0-9a-f]{7,40}) · schedules (?P<schedules>\\S+)$",
    "correction": "^Correction: (?P<ref>\\S+) · (?P<field>\\S+) was (?P<wrong>.+) · is (?P<right>.+)$"
  },
  "knowledge": {
    "note": "Python module agent_skills.knowledge (Wave 1 T6), imported by issues-cli. Stores named logically in § Map `Knowledge`; local checkouts from workers.json `knowledge_stores`; an unmapped brain is stated on reads and refused on writes.",
    "module": "agent_skills.knowledge",
    "config_key": "knowledge_stores",
    "functions": {
      "pages": {
        "args": "domain",
        "returns": "[{path, verified, sha, pending}]",
        "used_by": "brief"
      },
      "find": {
        "args": "words",
        "returns": "[{file, id, text, source, score, pending}] from answered, decisions and inbox/",
        "used_by": "sort"
      },
      "domains": {
        "args": "",
        "returns": "[domain]",
        "used_by": "publish label check"
      },
      "record": {
        "args": "kind=decision|lesson|answered, id, date, source, text, scope=global|tenant:<id>|repo:<name>",
        "returns": "{path} of one new inbox/ file; refuses a duplicate id",
        "used_by": "decide, Learned collector"
      },
      "collect": {
        "args": "",
        "returns": "{folded, pr}",
        "used_by": "daily run or on demand"
      },
      "log": {
        "args": "issue, timeline lines",
        "returns": "{path}; idempotent per issue",
        "used_by": "sweep only"
      },
      "stale": {
        "args": "",
        "returns": "[{path, verified, changed}]",
        "used_by": "sweep"
      },
      "lint": {
        "args": "",
        "returns": "[failure]",
        "used_by": "repo wiki lint script"
      }
    },
    "domain_vocabulary": "the store's routing table; conveyor.md lists none",
    "unmapped_brain": {
      "reads": "wiki only, output says `brain: not configured on this machine`",
      "writes": "record and log refuse loudly"
    }
  },
  "never_a_go": [
    "decision",
    "asked_more"
  ],
  "action_record": {
    "note": "Written by run-approved's prepare step; each kind runs one fixed code path; the record carries parameters only, never a command line.",
    "kinds": {
      "release": "safeguard release of the frozen train",
      "rollback": "safeguard rollback to the recorded Rollback ref",
      "skills-install": "install.sh at the record's tree; writes the settings snippet file, never applies it (settings stay the user's manual step)"
    },
    "fields": {
      "kind": "one of kinds",
      "id": "unique, never reused",
      "train": "[{issue, pr, head}] ≤ Release train limit",
      "tree": "git tree sha of the release",
      "targets": "[target]",
      "prepared_by": "session",
      "prepared_at": "UTC",
      "expires_at": "UTC",
      "digest_input": "canonical JSON of every field except digest and used_at",
      "digest": "sha256 of digest_input",
      "used_at": "UTC, set once on use"
    },
    "refusals": [
      "unknown-kind",
      "moved-head",
      "expired",
      "reused",
      "digest-mismatch",
      "hold",
      "train-over-limit"
    ],
    "command_lines": "forbidden",
    "no_kind": "the belt never runs a gated action without a kind; it stays with the user's own word in the executing session (contracts.md § Consent)"
  },
  "questions": {
    "bookkeeping": "never asked; authorizations.json",
    "go": "card required",
    "choice": "card required"
  },
  "card": {
    "kinds": [
      "go",
      "choice"
    ],
    "max_lines": 12,
    "fields": [
      "goal",
      "from",
      "changes",
      "checked",
      "if_yes",
      "if_no",
      "if_wait",
      "undo",
      "recommended",
      "link"
    ],
    "ai_writes": [
      "changes",
      "if_yes",
      "if_no",
      "if_wait",
      "recommended"
    ],
    "script_fills": {
      "goal": "goal name and step k of n",
      "from": "origin text stored at capture",
      "checked": "Checked: receipts present · Not yet: receipts missing, never omitted",
      "link": "full-page link",
      "undo": "go: from the action record's Rollback data"
    },
    "refuse": {
      "empty_field": true,
      "opens_with": "^(#|PR ?#?)\\d+\\b|^(?=[0-9a-f]*\\d)[0-9a-f]{7,40}\\b"
    },
    "tell_me_more": "records asked_more; not a decision; the question returns",
    "ai_fills_by_kind": {
      "choice": [
        "undo"
      ]
    },
    "go_shows": "kind, id and the first 8 characters of the digest"
  }
}
