{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Central task evidence event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "task_id",
    "session_id",
    "revision",
    "record_owner",
    "at_utc",
    "observed_at_utc",
    "kind",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,100}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,100}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,100}$"
    },
    "record_owner": {
      "type": "string"
    },
    "execution_owner": {
      "type": "string"
    },
    "at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "enum": [
        "start",
        "decision",
        "implementation",
        "test",
        "review",
        "deploy",
        "failure",
        "handoff",
        "verification",
        "proposal",
        "feedback",
        "cancellation",
        "close"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 240,
      "minLength": 1
    },
    "scope": {
      "type": "string"
    },
    "approval_ref": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "failed_approach": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "string"
    },
    "next_step": {
      "type": "string"
    },
    "lesson_proposal": {
      "type": "string"
    },
    "source_ref": {
      "type": "string"
    },
    "correction_of": {
      "type": "string"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dirty_diff_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "environment": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "claim",
          "ref"
        ],
        "properties": {
          "state": {
            "enum": [
              "performed",
              "reported",
              "independently_verified"
            ]
          },
          "claim": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "environment": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "verified_by": {
            "type": "string"
          }
        }
      }
    },
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "active",
        "blocked",
        "canceled",
        "done"
      ]
    },
    "new_record_owner": {
      "type": "string",
      "minLength": 1
    },
    "transfer_ack_ref": {
      "type": "string",
      "minLength": 1
    },
    "open_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resolved_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verified_revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "runtime_version": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "implementation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "validation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "outcomes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "monitoring": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "excluded_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "module_changes": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "what",
          "why"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "what": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "repo_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "branch_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "clear_next_step": {
      "const": true
    },
    "feedback_category": {
      "enum": [
        "user_correction",
        "confusion",
        "clarification",
        "scope_drift",
        "runbook_gap",
        "dispatch_failure",
        "repeated_blocker",
        "other"
      ]
    },
    "feedback_issue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "feedback_impact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "feedback_correction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "feedback_prevention_check": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "feedback_check_state": {
      "enum": [
        "unverified",
        "verified_pass",
        "verified_fail"
      ]
    },
    "feedback_check_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "feedback_cause": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "feedback_cause_basis": {
      "enum": [
        "observed",
        "hypothesis"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "start"
          }
        }
      },
      "then": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "active"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "handoff"
          }
        }
      },
      "then": {
        "required": [
          "new_record_owner",
          "transfer_ack_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cancellation"
          }
        }
      },
      "then": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "canceled"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "verification",
              "close"
            ]
          }
        }
      },
      "then": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "close"
          }
        }
      },
      "then": {
        "required": [
          "status",
          "verified_revision",
          "approval_ref"
        ],
        "properties": {
          "status": {
            "const": "done"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "verification"
          }
        }
      },
      "then": {
        "required": [
          "verified_revision"
        ]
      }
    },
    {
      "not": {
        "required": [
          "next_step",
          "clear_next_step"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "feedback"
          }
        }
      },
      "then": {
        "required": [
          "source_ref",
          "feedback_category",
          "feedback_issue",
          "feedback_impact",
          "feedback_correction",
          "feedback_prevention_check",
          "feedback_check_state",
          "evidence"
        ],
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "feedback_category"
              ]
            },
            {
              "required": [
                "feedback_issue"
              ]
            },
            {
              "required": [
                "feedback_impact"
              ]
            },
            {
              "required": [
                "feedback_correction"
              ]
            },
            {
              "required": [
                "feedback_prevention_check"
              ]
            },
            {
              "required": [
                "feedback_check_state"
              ]
            },
            {
              "required": [
                "feedback_check_ref"
              ]
            },
            {
              "required": [
                "feedback_cause"
              ]
            },
            {
              "required": [
                "feedback_cause_basis"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "feedback"
          },
          "feedback_check_state": {
            "const": "verified_pass"
          }
        }
      },
      "then": {
        "required": [
          "feedback_check_ref"
        ],
        "properties": {
          "evidence": {
            "contains": {
              "type": "object",
              "required": [
                "state",
                "ref",
                "outcome"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "performed",
                    "independently_verified"
                  ]
                },
                "outcome": {
                  "const": "pass"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "feedback"
          },
          "feedback_check_state": {
            "const": "verified_fail"
          }
        }
      },
      "then": {
        "required": [
          "feedback_check_ref"
        ],
        "properties": {
          "evidence": {
            "contains": {
              "type": "object",
              "required": [
                "state",
                "ref",
                "outcome"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "performed",
                    "independently_verified"
                  ]
                },
                "outcome": {
                  "const": "fail"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "feedback"
          },
          "feedback_check_state": {
            "const": "unverified"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "feedback_check_ref"
          ]
        }
      }
    },
    {
      "dependentRequired": {
        "feedback_cause": [
          "feedback_cause_basis"
        ],
        "feedback_cause_basis": [
          "feedback_cause"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "feedback"
          },
          "feedback_cause_basis": {
            "const": "observed"
          }
        },
        "required": [
          "feedback_cause_basis"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "type": "object",
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "performed",
                    "independently_verified"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "$comment": "Python history.validate is authoritative for cross-field equality: performed check evidence ref must exactly equal feedback_check_ref."
}
